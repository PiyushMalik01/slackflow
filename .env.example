# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL_HERE"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"

# ─── Encryption (AES-256-GCM) ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="YOUR_32_BYTE_HEX_STRING_HERE"

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
AI_MODEL="gpt-4o-mini"

# ─── Slack ────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID="YOUR_SLACK_CLIENT_ID_HERE"
SLACK_CLIENT_SECRET="YOUR_SLACK_CLIENT_SECRET_HERE"
SLACK_SIGNING_SECRET="YOUR_SLACK_SIGNING_SECRET_HERE"

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# ─── App URL ──────────────────────────────────────────────────────────────────
# The fully qualified domain name (without trailing slash)
# e.g., https://your-app.vercel.app or https://xxxx.ngrok.app
NEXT_PUBLIC_APP_URL="YOUR_PRODUCTION_DOMAIN_HERE"
SLACK_REDIRECT_URI="YOUR_PRODUCTION_DOMAIN_HERE/api/slack/callback"
